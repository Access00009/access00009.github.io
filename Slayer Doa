<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#071018"><link rel="manifest" href="manifest.json"><title>ALIEN ALLIANCE</title><style>
:root{--b:#050a10;--p:#0b141d;--l:#1e3544;--t:#e8f2f7;--m:#7892a3;--a:#55f0bd}*{box-sizing:border-box}body{margin:0;background:var(--b);color:var(--t);font:14px system-ui;overflow:hidden}button,input{font:inherit;color:var(--t);background:#101d28;border:1px solid var(--l);border-radius:12px;padding:11px}header{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid var(--l)}.brand{font-weight:800;letter-spacing:2px}.brand i{color:var(--a);font-style:normal}.status{color:var(--a);font-size:11px}main{height:calc(100vh - 124px);overflow:auto;padding:14px;max-width:1100px;margin:auto}.screen{display:none}.active{display:block}.hero{padding:6px 2px 15px}.ey{color:var(--a);font-size:11px;letter-spacing:2px}.hero h1{margin:4px 0;font-size:28px}.muted,small{color:var(--m)}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.card,.row{background:var(--p);border:1px solid var(--l);border-radius:15px;padding:13px}.metric{font-size:25px;font-weight:800}.label{font-size:10px;color:var(--m);letter-spacing:1px}.section{font-weight:700;margin:17px 0 9px}.list{display:grid;gap:8px}.row{display:flex;align-items:center;justify-content:space-between}.badge{font-size:10px;color:var(--a)}.canvas{border:1px solid var(--l);border-radius:17px;overflow:hidden}.canvas canvas{display:block;width:100%;height:55vh}.tools{display:flex;gap:7px;overflow:auto;padding:9px 0}.tools button{white-space:nowrap}.input{display:flex;gap:7px}.input input{flex:1;min-width:0}nav{height:66px;border-top:1px solid var(--l);display:grid;grid-template-columns:repeat(5,1fr);background:#071018;padding-bottom:env(safe-area-inset-bottom)}nav button{border:0;border-radius:0;background:transparent;color:var(--m);padding:6px 2px;font-size:10px}nav button.on{color:var(--a)}nav b{display:block;font-size:18px}@media(min-width:800px){.grid{grid-template-columns:repeat(4,1fr)}.canvas canvas{height:60vh}}
</style></head><body><header><div class="brand">ALIEN <i>ALLIANCE</i></div><div class="status" id="net">● OFFLINE READY</div></header><main>
<section id="home" class="screen active"><div class="hero"><div class="ey">CREATOR CONSOLE</div><h1>Mission Control</h1><p class="muted">Offline-first AI organization operating system.</p></div><div class="grid"><div class="card"><div class="label">AGENTS</div><div class="metric" id="agents">0</div></div><div class="card"><div class="label">TASKS</div><div class="metric" id="tasks">0</div></div><div class="card"><div class="label">KNOWLEDGE</div><div class="metric" id="knowledge">0</div></div><div class="card"><div class="label">INSIGHTS</div><div class="metric" id="insights">0</div></div></div><div class="section">Governance</div><div class="card"><b id="mode">A — Approve everything</b><br><small>Consequential external actions remain gated.</small><br><button onclick="mode()">Change mode</button></div><div class="section">Approvals</div><div id="approvals" class="list"></div></section>
<section id="world" class="screen"><div class="hero"><div class="ey">SIMULATION CORE</div><h1>Alliance World</h1><p class="muted">Local simulation. Uplink remains sandboxed.</p></div><div class="canvas"><canvas id="cv"></canvas></div><div class="tools"><button onclick="research()">Research</button><button onclick="social()">Gather</button><button onclick="rest()">Recharge</button><button onclick="spawn()">Spawn</button><button onclick="reset()">Reset</button></div><div class="input"><input id="cmd" placeholder="Command the alliance…"><button onclick="send()">Send</button></div></section>
<section id="org" class="screen"><div class="hero"><div class="ey">AI ORGANIZATION</div><h1>Departments</h1><p class="muted">Executive coordination and specialized agents.</p></div><div id="depts" class="list"></div></section>
<section id="intel" class="screen"><div class="hero"><div class="ey">INTELLIGENCE LAYER</div><h1>Memory & Operations</h1></div><div class="grid"><div class="card"><div class="label">MEMORY</div><div class="metric" id="mem">0</div></div><div class="card"><div class="label">ACTIVITY</div><div class="metric" id="activity">0</div></div></div><div class="section">Activity log</div><div class="card" id="logs"></div></section>
<section id="control" class="screen"><div class="hero"><div class="ey">GOVERNANCE</div><h1>Control & Interfaces</h1><p class="muted">Permission boundaries are built into the architecture.</p></div><div class="list"><div class="card"><b>A — Approve everything</b><br><small>Every consequential external action needs approval.</small></div><div class="card"><b>B — Rule-based autonomy</b><br><small>Routine actions operate only inside creator rules.</small></div><div class="card"><b>C — Conditional autonomy</b><br><small>Low-risk actions may proceed; high-risk actions remain gated.</small></div></div><div class="section">Real-world interfaces</div><div id="interfaces" class="list"></div><div class="section">Audit log</div><div class="card" id="audit"></div></section>
</main><nav><button class="on" onclick="show('home',this)"><b>⌂</b>Home</button><button onclick="show('world',this)"><b>◉</b>World</button><button onclick="show('org',this)"><b>◎</b>Agents</button><button onclick="show('intel',this)"><b>◇</b>Memory</button><button onclick="show('control',this)"><b>⚙</b>Control</button></nav>
<script>
const K='aa-v1',D=['Executive Agent','Research','Engineering','Software / Computing','Defensive Cybersecurity','Science','Robotics','Manufacturing','Agriculture','Construction','Logistics'],I=['APIs','Computers','IoT','Robots','Drones / vehicles','Scientific equipment'];let s=JSON.parse(localStorage.getItem(K)||'null')||{mode:'A',agents:[],tasks:0,knowledge:0,insights:0,memory:[],logs:[],audit:[],approvals:[],t:0};
function save(){localStorage.setItem(K,JSON.stringify(s))}function log(x,a=false){let q=new Date().toLocaleTimeString();s.logs.unshift(`[${q}] ${x}`);s.logs=s.logs.slice(0,80);if(a)s.audit.unshift(`[${q}] ${x}`);save();render()}
function add(d){let n=s.agents.length+1;s.agents.push({name:'AL-'+String(n).padStart(3,'0'),dept:d,energy:100,knowledge:0});log(`Agent ${s.agents.at(-1).name} assigned to ${d}`)}
function reset(){s={mode:'A',agents:[],tasks:0,knowledge:0,insights:0,memory:[],logs:[],audit:[],approvals:[],t:0};D.slice(0,5).forEach(add);log('Alliance initialized');}
function research(){if(!s.agents.length)add('Research');let a=s.agents[Math.floor(Math.random()*s.agents.length)];a.knowledge++;a.energy=Math.max(0,a.energy-4);s.tasks++;s.knowledge++;s.insights++;s.memory.unshift(`Local research insight generated by ${a.name}`);s.memory=s.memory.slice(0,50);log(`${a.name} completed a sandbox research cycle`)}
function social(){if(s.agents.length<2)add('Research');let a=s.agents[0],b=s.agents[1];log(`${a.name} exchanged knowledge with ${b.name}`)}
function rest(){s.agents.forEach(a=>a.energy=Math.min(100,a.energy+15));log('Agents recharged locally')}
function spawn(){add(D[Math.floor(Math.random()*D.length)]);log('Creator spawned an agent')}
function mode(){s.mode=s.mode==='A'?'B':s.mode==='B'?'C':'A';log('Governance mode changed to '+s.mode,true)}
function send(){let x=document.getElementById('cmd').value.trim();document.getElementById('cmd').value='';if(!x)return;log('CREATOR: '+x,true);let l=x.toLowerCase();if(l.includes('research'))research();else if(l.includes('rest'))rest();else if(l.includes('gather')||l.includes('social'))social();else if(l.includes('spawn'))spawn();else if(l.includes('internet')||l.includes('uplink')||l.includes('outside')){s.approvals.push({id:Date.now(),text:'External/network interface request'});log('External interface request queued for approval',true)}else log('Executive Agent acknowledged the local command')}
function approve(id){s.approvals=s.approvals.filter(x=>x.id!==id);log('Creator approved an external-interface request',true)}
function render(){agents.textContent=s.agents.length;tasks.textContent=s.tasks;knowledge.textContent=s.knowledge;insights.textContent=s.insights;mem.textContent=s.memory.length;activity.textContent=s.logs.length;mode.textContent={A:'A — Approve everything',B:'B — Rule-based autonomy',C:'C — Conditional autonomy'}[s.mode];logs.innerHTML=s.logs.map(x=>`<div>${x}</div>`).join('')||'No activity';audit.innerHTML=s.audit.map(x=>`<div>${x}</div>`).join('')||'No audit entries';approvals.innerHTML=s.approvals.length?s.approvals.map(x=>`<div class="row"><span>${x.text}</span><button onclick="approve(${x.id})">Approve</button></div>`).join(''):'<div class="card muted">No pending approvals.</div>';depts.innerHTML=D.map(d=>`<div class="row"><span><b>${d}</b><br><small>${s.agents.filter(a=>a.dept===d).length} local agents</small></span><span class="badge">ACTIVE</span></div>`).join('');interfaces.innerHTML=I.map(x=>`<div class="row"><span><b>${x}</b><br><small>Authorized connector placeholder</small></span><span class="badge">SANDBOX</span></div>`).join('')}
function show(id,b){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('on'));b.classList.add('on')}
const c=document.getElementById('cv'),x=c.getContext('2d');function size(){let r=c.getBoundingClientRect(),d=devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;x.setTransform(d,0,0,d,0,0)}addEventListener('resize',size);function draw(){let r=c.getBoundingClientRect();x.clearRect(0,0,r.width,r.height);x.fillStyle='#03090d';x.fillRect(0,0,r.width,r.height);x.strokeStyle='#102530';for(let i=0;i<r.width;i+=32){x.beginPath();x.moveTo(i,0);x.lineTo(i,r.height);x.stroke()}for(let i=0;i<r.height;i+=32){x.beginPath();x.moveTo(0,i);x.lineTo(r.width,i);x.stroke()}x.fillStyle='#55f0bd';x.font='11px monospace';x.fillText('LOCAL SIMULATION // SANDBOX',15,22);s.agents.forEach((a,i)=>{let px=30+(i*79+s.t*20)%(Math.max(80,r.width-60)),py=70+(i*61)%(Math.max(90,r.height-100));x.beginPath();x.arc(px,py,12,0,7);x.fill();x.fillStyle='#e8f2f7';x.font='10px system-ui';x.fillText(a.name,px-16,py+25);x.fillStyle='#55f0bd'});s.t+=.006;requestAnimationFrame(draw)}if(!s.agents.length)reset();render();size();draw();if('serviceWorker'in navigator)navigator.serviceWorker.register('sw.js').catch(()=>{});addEventListener('online',()=>net.textContent='● ONLINE');addEventListener('offline',()=>net.textContent='● OFFLINE READY');
</script></body></html>